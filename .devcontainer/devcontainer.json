{
  "name": "Chatwoot Development Codespace",
  "service": "app",
  "dockerComposeFile": "docker-compose.yml",
  "settings": {
    "terminal.integrated.shell.linux": "/bin/zsh",
    "editor.formatOnSave": true
  },
  "forwardPorts": [8025, 3000, 3036],
  "portsAttributes": {
    "3000": { "label": "Rails Server", "visibility": "public" },
    "3036": { "label": "Vite Dev Server", "visibility": "public" },
    "8025": { "label": "Mailhog UI", "visibility": "public" }
  },
  "postCreateCommand": "pnpm install",
  "postStartCommand": "bash -c 'sleep 10 && bin/start-all > /tmp/startup.log 2>&1 &'"
}
