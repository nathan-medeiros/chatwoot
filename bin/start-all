#!/usr/bin/env bash
# Inicia Vite (dev server) + Rails (web server) em background persistente.
# Rodado automaticamente pelo postStartCommand do devcontainer.
# Logs em /tmp/vite.log e /tmp/rails.log

set -e

cd "$(dirname "$0")/.."

# Mata instâncias anteriores (Rails, Vite, pids em 3036/3000)
pkill -9 -f 'rails s'           2>/dev/null || true
pkill -9 -f 'vite'              2>/dev/null || true
fuser -k -9 3036/tcp 2>/dev/null || true
fuser -k -9 3000/tcp 2>/dev/null || true
sleep 2

# Vite (porta 3036, host 0.0.0.0 para codespace proxy)
nohup bin/vite dev > /tmp/vite.log 2>&1 &
VITE_PID=$!
echo "vite pid: $VITE_PID"

# Rails (porta 3000, bind 0.0.0.0)
nohup bundle exec rails s -b 0.0.0.0 -p 3000 > /tmp/rails.log 2>&1 &
RAILS_PID=$!
echo "rails pid: $RAILS_PID"

disown -a 2>/dev/null || true

echo "Chatwoot iniciando..."
echo "  Rails: http://localhost:3000  (logs: /tmp/rails.log)"
echo "  Vite:  http://localhost:3036  (logs: /tmp/vite.log)"
echo "Aguardando ficarem prontos..."

# Aguarda Rails responder (até 90s)
for i in $(seq 1 90); do
  RAILS_OK=$(curl -s -o /dev/null -w '%{http_code}' http://localhost:3000/ 2>/dev/null || echo 000)
  VITE_OK=$(curl -s -o /dev/null -w '%{http_code}' http://localhost:3036/ 2>/dev/null || echo 000)
  if [[ "$RAILS_OK" =~ ^(200|302)$ ]] && [[ "$VITE_OK" =~ ^(200|304)$ ]]; then
    echo "Pronto após ${i}s (Rails=$RAILS_OK Vite=$VITE_OK)"
    exit 0
  fi
  sleep 1
done

echo "AVISO: nem Rails nem Vite responderam em 90s"
echo "--- /tmp/rails.log (últimas 30) ---"
tail -30 /tmp/rails.log 2>/dev/null || true
echo "--- /tmp/vite.log (últimas 30) ---"
tail -30 /tmp/vite.log 2>/dev/null || true
exit 1
