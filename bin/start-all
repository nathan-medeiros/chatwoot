#!/usr/bin/env bash
# Inicia Vite (dev server) + Rails (web server) em background persistente.
# Rodado automaticamente pelo postStartCommand do devcontainer.
# Logs em /tmp/vite.log e /tmp/rails.log

set -e

cd "$(dirname "$0")/.."

# Mata instâncias anteriores, se houver
pkill -f 'rails s' 2>/dev/null || true
pkill -f 'vite'    2>/dev/null || true
sleep 1

# Vite (porta 3036)
nohup bin/vite dev > /tmp/vite.log 2>&1 &
echo "vite pid: $!"

# Rails (porta 3000)
nohup bundle exec rails s -b 0.0.0.0 -p 3000 > /tmp/rails.log 2>&1 &
echo "rails pid: $!"

disown -a 2>/dev/null || true

echo "Chatwoot iniciando..."
echo "  Rails: http://localhost:3000  (logs: /tmp/rails.log)"
echo "  Vite:  http://localhost:3036  (logs: /tmp/vite.log)"
echo "Aguardando Rails ficar pronto..."

# Aguarda Rails responder (até 60s)
for i in $(seq 1 60); do
  if curl -s -o /dev/null -w '%{http_code}' http://localhost:3000/ 2>/dev/null | grep -qE '200|302'; then
    echo "Rails pronto após ${i}s"
    exit 0
  fi
  sleep 1
done

echo "AVISO: Rails não respondeu em 60s. Veja /tmp/rails.log"
tail -30 /tmp/rails.log
exit 1
