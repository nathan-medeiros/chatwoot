#!/usr/bin/env bash
set -e
cd /workspaces/chatwoot
echo "Preparando banco..."
bundle exec rake db:chatwoot_prepare 2>/dev/null || true
pkill -9 -f "rails" || true
pkill -9 -f "vite" || true
sleep 2
nohup bundle exec vite dev --host 0.0.0.0 --port 3036 > /tmp/vite.log 2>&1 &
nohup bundle exec rails s -b 0.0.0.0 -p 3000 > /tmp/rails.log 2>&1 &
echo "Servidores iniciados"
