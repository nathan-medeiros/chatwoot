#!/usr/bin/env bash
set -e
cd /workspaces/chatwoot

chmod +x bin/vite 2>/dev/null || true

echo "Aguardando PostgreSQL..."
until pg_isready -h localhost -U postgres -p 5432 2>/dev/null; do sleep 1; done

echo "Preparando banco de dados..."
POSTGRES_STATEMENT_TIMEOUT=600s bundle exec rake db:chatwoot_prepare 2>&1 | tail -3 || true

pkill -9 -f "rails s" 2>/dev/null || true
pkill -9 -f "vite" 2>/dev/null || true
sleep 2

nohup bash -c "cd /workspaces/chatwoot && bundle exec vite dev" > /tmp/vite.log 2>&1 &
echo "vite pid: $!"

nohup bash -c "cd /workspaces/chatwoot && bundle exec rails s -b 0.0.0.0 -p 3000" > /tmp/rails.log 2>&1 &
echo "rails pid: $!"

disown -a 2>/dev/null || true

echo "Aguardando servidores..."
for i in $(seq 1 120); do
  RAILS=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:3000/ 2>/dev/null || echo 000)
  VITE=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:3036/ 2>/dev/null || echo 000)
  [[ "$RAILS" =~ ^(200|302)$ ]] && [[ "$VITE" =~ ^(200|302|304)$ ]] && echo "Pronto ${i}s (Rails=$RAILS Vite=$VITE)" && exit 0
  sleep 1
done

echo "AVISO: timeout"
tail -20 /tmp/rails.log 2>/dev/null
tail -20 /tmp/vite.log 2>/dev/null
exit 1
